-// Invalidate pattern and create selectors/variants if necessary
-void MFDataModel::Builder::buildSelectorsMessage(UErrorCode& status) {
-    CHECK_ERROR(status);
-
-    if (hasPattern) {
-        selectors = createUVector(status);
