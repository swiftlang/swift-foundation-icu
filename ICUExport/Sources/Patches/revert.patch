-// `v` is assumed to be a vector of strings
-static int32_t vectorFind(const UVector& v, const UnicodeString& k) {
-    for (int32_t i = 0; i < v.size(); i++) {
-        if (*static_cast<UnicodeString*>(v[i]) == k) {
-            return i;
-        }
-    }
-    return -1;
-}
