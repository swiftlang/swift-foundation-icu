-            if (!key.isWildcard()) {
-                // 5iii(c)(a). Assert that `key` is a literal.
-                // (Not needed)
-                // 5iii(c)(b). Let `ks` be the resolved value of `key`.
-                UnicodeString ks = key.asLiteral().unquoted();
