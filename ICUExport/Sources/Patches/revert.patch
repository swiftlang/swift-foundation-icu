-void Parser::maybeAdvanceLine() {
-    if (peek() == LF) {
-        parseError.line++;
-        // add 1 to index to get the number of characters seen so far
-        // (including the newline)
-        parseError.lengthBeforeCurrentLine = index + 1;
-    }
