-static void copyContext(const UChar in[U_PARSE_CONTEXT_LEN], UChar out[U_PARSE_CONTEXT_LEN]) {
-    for (int32_t i = 0; i < U_PARSE_CONTEXT_LEN; i++) {
-        out[i] = in[i];
-        if (in[i] == '\0') {
-            break;
-        }
-    }
